# Copy to .env and fill real values. Never commit .env.
# IMPORTANT: never paste your real SUPABASE_SERVICE_ROLE_KEY here (or anywhere
# that gets committed). It is a SECRET and must only live in your local .env.
PORT=5000

# ---- Supabase (shared backend for a.com + b.com) ----
# https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://YOURPROJECT.supabase.co
# Public/publishable key — safe to be public, used for client auth.
SUPABASE_ANON_KEY=sb_publishable_XXXX_or_paste_publishable_jwt
# SECRET service-role key — SERVER SIDE ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...paste_your_service_role_secret_here...

# ---- Backend Services ----
# Comma-separated list of allowed browser origins (CORS).
FRONTEND_URL=http://localhost:5000,http://localhost:3000,https://aperonight.fun

# Mock payment provider:
#   "both"      -> the mock checkout can simulate success OR failure (dev only)
#   "success"   -> mock always succeeds
#   "failure"   -> mock always fails
# The mock provider is DEVELOPMENT ONLY and must never be used in production.
MOCK_PAYMENT_MODE=both