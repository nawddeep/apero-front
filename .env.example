# Copy to .env and fill real values. Never commit .env.
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@aperonight.fun
ADMIN_PASSWORD=1234567890
FRONTEND_URL=https://aperonight.fun

# Rate limiting config (optional, defaults shown)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=900000
